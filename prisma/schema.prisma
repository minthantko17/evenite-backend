// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  CONCLUDED
  CANCELLED
}

enum FormType {
  REGISTRATION
  FEEDBACK
}

enum FieldType {
  TEXT
  TEXTAREA
  CHOICE
  NUMBER
  RATING
  DATE
  CHECKBOX
}

model Event {
  id          String      @id @default(uuid())
  title       Json?        
  description Json?        
  category    String[]    
  bannerUrl   String?     
  location    Json?
  mapLink     String?
  isOnline    Boolean     @default(false)
  startAt     DateTime?
  endAt       DateTime?
  seatLimit   Int?        
  status      EventStatus @default(DRAFT)
  hasCatering     Boolean @default(false)
  isCateringFree  Boolean @default(false)
  cateringDescription Json?   
  agenda  Json?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  contactLineId String?
  externalUrl String?
  remarks Json?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  forms   Form[]
}

model Form {
  id          String         @id @default(uuid())
  eventId     String
  type        FormType
  title       String?
  description String?

  event       Event          @relation(fields: [eventId], references: [id])
  fields      FormField[]
  responses   FormResponse[]

  @@unique([eventId, type])
}

model FormField {
  id          String        @id @default(uuid())
  formId      String
  type        FieldType
  label       String
  isRequired  Boolean       @default(false)
  order       Int
  options     Json?
  autoFillKey String?

  form        Form                @relation(fields: [formId], references: [id])
  responses   FormFieldResponse[]

  @@unique([formId, order])
  @@unique([id, formId])
}

model FormResponse {
  id             String     @id @default(uuid())
  formId         String
  createdAt      DateTime   @default(now())
  // registrationId String           // deferred Feature #5
  // @@unique([registrationId, formId])  // deferred Feature #5

  form           Form                @relation(fields: [formId], references: [id])
  fieldResponses FormFieldResponse[]

  @@unique([id, formId])
}

model FormFieldResponse {
  id             String       @id @default(uuid())
  formResponseId String
  formFieldId    String
  formId         String
  valueText      String?
  valueNumber    Decimal?
  valueDate      DateTime?
  valueJson      Json?

  formResponse   FormResponse @relation(fields: [formResponseId, formId], references: [id, formId])
  formField      FormField    @relation(fields: [formFieldId, formId], references: [id, formId])

  @@unique([formResponseId, formFieldId])
}